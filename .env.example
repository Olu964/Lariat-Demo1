[TEMPLATE]
# Open States API key: https://openstates.org/accounts/signup/
OPEN_STATES_API_KEY=

# OpenRouter API key for bill summarization: https://openrouter.ai/keys
# (optional if GEMINI_API_KEY below is set; OpenRouter is tried first)
OPENROUTER_API_KEY=

# Google Gemini API key for the helpbot's AI answers: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini model override (default: gemini-flash-latest).
GEMINI_MODEL=

# Optional first OpenRouter model. Leave blank to start with the preferred
# available free model; capacity errors automatically move to the next one.
SUMMARIZER_MODEL=

# --- Backend (server/server.js) --------------------------------------------
# The defaults below are safe for local development only. For internet
# deployment, set NODE_ENV=production and provide every required production
# value documented in SECURITY.md.

# Brevo API key: https://app.brevo.com/settings/keys/api
# (free tier: 300 emails/day, no credit card; verify a sender address in
# Brevo by clicking a confirmation email  -  no domain purchase required).
# Leave blank for "console mode": verification codes are printed to the
# terminal instead of emailed, so the full flow can be tested with no account.
BREVO_API_KEY=

# Sender address, e.g. alerts@yourdomain.com or any address you verified in
# Brevo (you can verify a plain Gmail-style address by email  -  no domain needed).
BREVO_FROM_EMAIL=

# How long a verification code stays valid (minutes).
SUBSCRIPTION_CODE_EXPIRY_MINUTES=10

# Secret used to sign one-click unsubscribe links in emails (HMAC-SHA256).
# If unset, a random secret is generated at startup, so links stop working
# after a restart. Set a fixed value to keep links valid across restarts.
SUBSCRIPTION_SIGNING_SECRET=

# Key that encrypts stored subscriber emails at rest (AES-256-GCM, 64 hex
# characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production (the server refuses to start without it). Without it,
# emails are stored in plaintext — fine for local testing only. Changing it
# later makes previously stored emails unreadable, so back it up with your
# other secrets. Never commit the real value.
SUBSCRIPTION_DATA_KEY=

# How long unsubscribe links stay valid (days). Keep this as short as the
# product supports; 90 days is the default.
SUBSCRIPTION_UNSUBSCRIBE_TOKEN_DAYS=90

# Shared secret that authorizes POST /api/notifications/dispatch (the daily
# digest trigger from the GitHub bill-refresh workflow). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME value in the Vercel environment, this .env, and the GitHub
# Actions secret NOTIFICATIONS_SECRET. Leave blank to disable dispatch.
NOTIFICATIONS_SECRET=

# Port and bind address. Keep HOST=127.0.0.1 for local development.
PORT=3000
HOST=127.0.0.1

# Production public URL used in unsubscribe emails. Must be HTTPS in production.
PUBLIC_BASE_URL=

# Comma-separated Host header allowlist. Localhost values are the safe default;
# add your production hostname when running behind a reverse proxy.
ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Optional exact browser origins for a separately hosted frontend. Leave blank
# when the backend serves the frontend from the same origin.
ALLOWED_ORIGINS=

# Set to production only after completing the production checklist.
NODE_ENV=development
